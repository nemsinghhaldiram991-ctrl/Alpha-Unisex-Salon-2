  .hero { grid-template-columns: 1fr 0.82fr; gap: 14px; min-height: 560px; }
  .hero-art { min-height: 420px; }
  .art-label { right: -10px; bottom: 32px; }
  .intro-grid, .review-inner, .location-inner { gap: 44px; }
}

@media (max-width: 650px) {
  .salon-header { width: calc(100% - 36px); height: 78px; }
  .brand-mark { width: 38px; height: 38px; font-size: 19px; }
  .brand-name { font-size: 9px; }
  .nav-links { gap: 0px; }
  .nav-links a:not(.nav-cta) { display: none; }
  .nav-links .nav-cta { padding: 10px 13px; font-size: 11px; }
