:root { --background: 40 39% 95%; --foreground: 345 22% 18%; --border: 36 23% 84%; --input: 36 23% 84%; --ring: 12 63% 57%; --card: 40 39% 95%; --card-foreground: 345 22% 18%; --primary: 12 63% 57%; --primary-foreground: 40 39% 95%; --secondary: 156 25% 82%; --secondary-foreground: 345 22% 18%; --muted: 37 25% 89%; --muted-foreground: 348 10% 43%; --accent: 157 25% 79%; --accent-foreground: 345 22% 18%; --app-font-sans: 'DM Sans', sans-serif; --app-font-serif: 'Playfair Display', Georgia, serif; --app-font-mono: 'DM Sans', sans-serif; --radius: 0.6rem; }

.dark { --background: 345 22% 18%; --foreground: 40 39% 95%; --border: 345 13% 34%; --input: 345 13% 34%; --ring: 12 63% 65%; --card: 345 22% 21%; --card-foreground: 40 39% 95%; --primary: 12 63% 65%; --primary-foreground: 345 22% 18%; --secondary: 157 18% 35%; --secondary-foreground: 40 39% 95%; --muted: 345 13% 28%; --muted-foreground: 37 14% 73%; --accent: 157 18% 35%; --accent-foreground: 40 39% 95%; }

@layer base {
  * { border-color: hsl(var(--border)); }
  html { scroll-behavior: smooth; }
  body { background-color: hsl(var(--background)); font-family: var(--app-font-sans); color: hsl(var(--foreground)); -webkit-font-smoothing: antialiased; margin: 0px; }
