:root { --ink: #38262d; --paper: #f5f0e5; --clay: #d66f58; --sage: #b8cdbd; }

* { box-sizing: border-box; }

::selection { background: rgb(214, 111, 88); color: rgb(255, 250, 240); }

.salon-shell { overflow: hidden; background: var(--paper); }

.salon-header { width: min(1280px, 100% - 72px); margin: 0px auto; height: 96px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(56, 38, 45, 0.15); }

.brand { display: flex; align-items: center; gap: 13px; color: var(--ink); text-decoration: none; }

.brand-mark { width: 43px; height: 43px; border: 1px solid var(--ink); border-radius: 50%; display: grid; place-items: center; font-family: var(--app-font-serif); font-size: 22px; }

.brand-name { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; line-height: 1.45; text-transform: uppercase; }

.nav-links { display: flex; align-items: center; gap: 36px; }

.nav-links a { color: var(--ink); text-decoration: none; font-size: 13px; font-weight: 600; transition: color 0.2s; }

.nav-links a:hover { color: var(--clay); }

.nav-links .nav-cta { border: 1px solid var(--ink); padding: 12px 18px; transition: background 0.2s, color 0.2s; }

.nav-links .nav-cta:hover { background: var(--ink); color: var(--paper); }

.hero { width: min(1280px, 100% - 72px); margin: 0px auto; min-height: 650px; display: grid; grid-template-columns: 1fr 0.95fr; align-items: center; gap: 48px; padding: 58px 0px 72px; }

.hero-copy { position: relative; z-index: 1; animation: 0.8s ease 0s 1 normal both running rise-in; }

.eyebrow { display: flex; align-items: center; gap: 11px; color: rgb(169, 81, 64); font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }

.eyebrow::before { content: ""; width: 30px; height: 1px; background: var(--clay); }

.hero h1 { font-family: var(--app-font-serif); font-size: clamp(62px, 7.4vw, 108px); font-weight: 500; line-height: 0.98; letter-spacing: -0.055em; margin: 28px 0px 23px; max-width: 650px; }

.hero h1 em { color: var(--clay); font-weight: 500; }

.hero-description { color: rgb(105, 91, 93); font-size: 16px; line-height: 1.8; max-width: 430px; margin: 0px; }

.hero-actions { display: flex; align-items: center; gap: 13px; margin-top: 33px; }

.button { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 0px 21px; color: var(--paper); background: var(--ink); text-decoration: none; font-size: 12px; font-weight: 700; letter-spacing: 0.03em; transition: transform 0.2s, background 0.2s; }

.button:hover { transform: translateY(-2px); background: rgb(90, 59, 68); }

.button.secondary { background: transparent; color: var(--ink); border: 1px solid rgba(56, 38, 45, 0.45); }

.button.secondary:hover { background: var(--sage); border-color: var(--sage); }

.hero-footnote { margin-top: 34px; display: flex; align-items: center; gap: 10px; color: rgb(118, 104, 106); font-size: 12px; }

.hero-footnote svg { color: rgb(169, 81, 64); }

.hero-art { position: relative; min-height: 500px; display: grid; place-items: center; animation: 1.2s ease 0.1s 1 normal both running fade-in; }

.art-panel { width: min(100%, 500px); aspect-ratio: 0.92 / 1; position: relative; overflow: hidden; background: rgb(217, 224, 208); border-radius: 48% 48% 5px 5px; isolation: isolate; }

.salon-photo { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 42%; }

.art-panel::before { content: ""; position: absolute; inset: 20px; border: 1px solid rgba(56, 38, 45, 0.32); border-radius: 48% 48% 2px 2px; z-index: 2; }

.art-label { position: absolute; right: 0px; bottom: 48px; z-index: 3; padding: 17px 21px; background: var(--paper); color: var(--ink); box-shadow: rgba(56, 38, 45, 0.1) 0px 12px 34px; font-family: var(--app-font-serif); font-size: 19px; line-height: 1.2; transform: rotate(2deg); }

.art-label span { display: block; margin-top: 5px; font-family: var(--app-font-sans); font-size: 9px; text-transform: uppercase; letter-spacing: 0.15em; }

.side-note { position: absolute; left: 0px; top: 46%; transform: translate(-35%, -50%) rotate(-90deg); font-size: 9px; letter-spacing: 0.2em; color: rgb(121, 107, 104); text-transform: uppercase; }

.rating-strip { background: var(--ink); color: var(--paper); }

.rating-inner { width: min(1280px, 100% - 72px); min-height: 112px; margin: auto; display: grid; grid-template-columns: 1.1fr 1fr 1fr; align-items: center; }

.rating-item { min-height: 64px; padding: 5px 34px; border-left: 1px solid rgba(245, 240, 229, 0.22); display: flex; align-items: center; gap: 17px; }

.rating-item:first-child { border-left: 0px; padding-left: 0px; }

.rating-number { color: rgb(230, 154, 128); font-family: var(--app-font-serif); font-size: 38px; line-height: 1; }

.rating-detail { color: rgba(245, 240, 229, 0.72); font-size: 11px; line-height: 1.55; }

.stars { display: flex; align-items: center; gap: 3px; color: rgb(233, 174, 102); font-size: 14px; }

.rating-detail strong { display: block; color: var(--paper); font-size: 13px; font-weight: 600; }

.intro-section { padding: 120px 36px 130px; }

.intro-grid { max-width: 1030px; margin: auto; display: grid; grid-template-columns: 0.75fr 1.25fr; gap: 90px; align-items: start; }

.section-mark { font-size: 10px; letter-spacing: 0.18em; color: rgb(169, 81, 64); text-transform: uppercase; font-weight: 700; }

.intro-section h2, .location-section h2 { font-family: var(--app-font-serif); font-weight: 500; letter-spacing: -0.04em; }

.intro-section h2 { font-size: clamp(38px, 4.4vw, 57px); line-height: 1.08; margin: 19px 0px 0px; }

.intro-copy { padding-top: 29px; }

.intro-copy p { margin: 0px 0px 17px; color: rgb(105, 91, 93); font-size: 15px; line-height: 1.9; }

.welcome-tag { display: inline-flex; align-items: center; gap: 9px; margin-top: 15px; padding: 11px 14px; border: 1px solid rgb(183, 201, 183); color: rgb(70, 86, 75); font-size: 11px; font-weight: 600; }

.welcome-tag svg { color: rgb(84, 115, 92); }

.review-section { background: rgb(232, 228, 216); padding: 92px 36px 100px; }

.review-inner { max-width: 1120px; margin: auto; display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 75px; align-items: center; }

.review-heading h2 { font-size: clamp(40px, 4.7vw, 62px); line-height: 1.04; margin: 18px 0px; }

.review-heading p { color: rgb(105, 91, 93); font-size: 13px; line-height: 1.8; max-width: 330px; }

.review-card { position: relative; padding: 35px 40px 32px; background: rgb(245, 240, 229); border: 1px solid rgba(56, 38, 45, 0.13); }

.quote-mark { color: var(--clay); font-family: var(--app-font-serif); font-size: 68px; line-height: 0.65; }

.review-card p { margin: 21px 0px 24px; max-width: 450px; font-family: var(--app-font-serif); font-size: 25px; line-height: 1.35; }

.review-card small { display: block; color: rgb(113, 100, 102); font-size: 11px; line-height: 1.7; }

.review-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 23px; color: var(--ink); text-decoration: none; font-size: 11px; font-weight: 700; border-bottom: 1px solid var(--clay); padding-bottom: 5px; }

.review-link:hover { color: rgb(169, 81, 64); }

.location-section { padding: 114px 36px 120px; background: rgb(248, 244, 235); }

.location-inner { max-width: 1120px; margin: auto; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 80px; align-items: center; }

.location-section h2 { margin: 20px 0px 14px; font-size: clamp(43px, 5vw, 65px); line-height: 1.02; }

.address { max-width: 415px; color: rgb(105, 91, 93); font-size: 14px; line-height: 1.8; }

.location-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

.location-card { min-height: 300px; position: relative; overflow: hidden; padding: 35px; background-color: rgb(220, 228, 215); background-image: linear-gradient(30deg, transparent 47%, rgba(56, 38, 45, 0.12) 48%, rgba(56, 38, 45, 0.12) 49%, transparent 50%), linear-gradient(120deg, transparent 44%, rgba(56, 38, 45, 0.11) 45%, rgba(56, 38, 45, 0.11) 46%, transparent 47%); background-size: 94px 88px, 126px 118px; }

.map-block { position: absolute; background: rgba(245, 240, 229, 0.8); }

.map-block.one { width: 35%; height: 29%; top: 12%; left: 9%; transform: rotate(-7deg); }

.map-block.two { width: 37%; height: 34%; right: 8%; bottom: 12%; transform: rotate(8deg); }

.map-path { position: absolute; height: 2px; width: 130%; top: 51%; left: -12%; background: rgb(201, 120, 98); transform: rotate(-20deg); }

.map-dot { position: absolute; top: 46%; left: 48%; z-index: 1; width: 20px; height: 20px; border: 5px solid rgb(248, 244, 235); border-radius: 50%; background: var(--clay); box-shadow: 0 0 0 1px var(--clay); }

.map-caption { position: absolute; z-index: 2; bottom: 22px; left: 23px; padding: 12px 15px; background: var(--paper); color: var(--ink); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }

.contact-band { padding: 76px 36px; background: var(--clay); color: rgb(255, 247, 237); }

.contact-inner { max-width: 1120px; margin: auto; display: flex; justify-content: space-between; align-items: center; gap: 32px; }

.contact-inner h2 { margin: 0px; font-family: var(--app-font-serif); font-size: clamp(34px, 4vw, 52px); font-weight: 500; line-height: 1.08; }

.contact-inner p { margin: 12px 0px 0px; color: rgba(255, 247, 237, 0.8); font-size: 13px; }

.button.light { flex: 0 0 auto; background: var(--paper); color: var(--ink); }

.button.light:hover { background: rgb(255, 249, 239); }

.footer { padding: 29px 36px; background: var(--ink); color: var(--paper); }

.footer-inner { width: min(1280px, 100%); margin: auto; display: flex; justify-content: space-between; align-items: center; gap: 24px; }

.footer .brand { color: var(--paper); }

.footer .brand-mark { border-color: rgba(245, 240, 229, 0.65); }

.footer-note { color: rgba(245, 240, 229, 0.62); font-size: 10px; text-align: right; line-height: 1.7; }

.footer-note a { color: var(--paper); text-decoration: none; }

@keyframes rise-in { 
  0% { opacity: 0; transform: translateY(22px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes fade-in { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@media (max-width: 850px) {
