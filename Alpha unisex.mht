  .hero-description { font-size: 14px; max-width: 390px; }
  .hero-actions { flex-wrap: wrap; margin-top: 25px; }
  .button { min-height: 48px; padding: 0px 16px; }
  .hero-footnote { margin-top: 23px; font-size: 11px; }
  .hero-art { min-height: 360px; margin: 0px 20px 0px 30px; }
  .art-panel { width: min(100%, 360px); aspect-ratio: 0.94 / 1; }
  .side-note { transform: translate(-37%, -50%) rotate(-90deg) scale(0.85); }
  .rating-inner { width: calc(100% - 36px); grid-template-columns: 1fr; padding: 15px 0px; }
  .rating-item, .rating-item:first-child { min-height: 66px; padding: 10px 0px; border-left: 0px; border-bottom: 1px solid rgba(245, 240, 229, 0.2); }
  .rating-item:last-child { border-bottom: 0px; }
  .rating-number { font-size: 34px; min-width: 76px; }
  .intro-section { padding: 75px 24px 80px; }
  .intro-grid, .review-inner, .location-inner { grid-template-columns: 1fr; gap: 25px; }
  .intro-section h2 { max-width: 390px; font-size: 42px; }
  .intro-copy { padding-top: 0px; }
  .intro-copy p { font-size: 14px; }
  .review-section { padding: 70px 24px 75px; }
  .review-heading h2 { font-size: 47px; max-width: 380px; }
  .review-card { padding: 29px 25px; }
  .review-card p { font-size: 22px; }
  .location-section { padding: 76px 24px 80px; }
  .location-section h2 { font-size: 49px; }
  .address { font-size: 13px; }
  .location-card { min-height: 250px; }
  .contact-band { padding: 57px 24px; }
  .contact-inner { display: block; }
  .contact-inner h2 { font-size: 39px; }
  .contact-inner .button { margin-top: 25px; }
  .footer { padding: 24px; }
  .footer-inner { align-items: flex-start; flex-direction: column; }
  .footer-note { text-align: left; }
}

